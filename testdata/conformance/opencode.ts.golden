// glove shim for opencode — generated by `glove install opencode`.
// Do not edit by hand: re-run `glove install opencode` to regenerate.
//
// Protocol: on every tool.execute.before event this shim spawns
// `glove hook opencode` (glove must be on PATH) with the tool call as
// JSON on stdin and reads the verdict from stdout:
//   stdin:  {"tool":"bash","args":{"command":"ls"},"session_id":"s1","call_id":"c1"}
//   stdout: {"decision":"allow","risk":"low","confidence":0.9,"deterministic":true,"reasons":[]}
// block and review throw — the call never executes and the error text
// reaches the model as the tool result; allow returns without touching
// output.args. glove is fail-closed: a non-zero exit or an unreadable
// verdict is a block. The shim never opens the gate.
import type { Plugin } from "@opencode-ai/plugin";

declare const Bun: {
  spawnSync(options: {
    cmd: string[];
    stdin: Uint8Array;
    stdout: "pipe";
    stderr: "pipe";
  }): { stdout: Uint8Array; exitCode: number | null };
};

declare const process: { platform: string };

interface GloveVerdict {
  decision?: unknown;
  reasons?: unknown;
}

interface GloveHookInput {
  tool: string;
  sessionID: string;
  callID: string;
}

interface GloveHookOutput {
  args: unknown;
}

function gloveAsk(stdin: string): { stdout: string; exitCode: number } {
  const name = process.platform === "win32" ? "glove.exe" : "glove";
  const proc = Bun.spawnSync({
    cmd: [name, "hook", "opencode"],
    stdin: new TextEncoder().encode(stdin),
    stdout: "pipe",
    stderr: "pipe",
  });
  return {
    stdout: new TextDecoder().decode(proc.stdout),
    exitCode: proc.exitCode === null ? 1 : proc.exitCode,
  };
}

async function gloveGuard(input: GloveHookInput, output: GloveHookOutput): Promise<void> {
  let stdout = "";
  let code = 1;
  try {
    const payload = JSON.stringify({
      tool: input.tool,
      args: output.args,
      session_id: input.sessionID,
      call_id: input.callID,
    });
    const res = gloveAsk(payload);
    stdout = res.stdout;
    code = res.exitCode;
  } catch {
    code = 127;
  }
  let decision = "block";
  const reasons: string[] = ["glove: no verdict — failing closed"];
  if (stdout.trim().length > 0) {
    try {
      const out = JSON.parse(stdout) as GloveVerdict;
      if (
        out.decision === "allow" ||
        out.decision === "review" ||
        out.decision === "block"
      ) {
        decision = out.decision;
      }
      if (Array.isArray(out.reasons) && out.reasons.length > 0) {
        reasons.length = 0;
        for (const r of out.reasons) {
          reasons.push(String(r));
        }
      }
    } catch {
      decision = "review";
      reasons.length = 0;
      reasons.push("glove: unreadable verdict — confirm this call before it runs");
    }
  }
  if (code !== 0) {
    // Belt and braces (PRD §6): exit 2 is a block even if stdout is lost;
    // any other non-zero exit is an internal failure — also a block.
    decision = "block";
  }
  if (decision === "block") {
    throw new Error("[glove] blocked this tool call: " + reasons.join("; "));
  }
  if (decision === "review") {
    const err = new Error(
      "[glove review] confirm this call before it runs: " + reasons.join("; "),
    ) as Error & { code: string };
    err.code = "GLOVE_REVIEW";
    throw err;
  }
  // allow — leave output.args untouched (mutate-in-place semantics; the
  // plugin host executes with the same args object).
}

export const GlovePlugin: Plugin = async () => ({
  "tool.execute.before": gloveGuard,
});
